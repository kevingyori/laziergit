#!/bin/sh
# Guards the parity grader. Installed with: git config core.hooksPath parity/hooks
#  - the harness (the code that scores the app against lazygit) changes only
#    with an oracle approval: an "Oracle-approved: O-…" line naming an entry
#    in parity/ORACLE.md;
#  - parity/passing.txt only grows;
#  - lazygit's version stays put, and is never replaced.
set -eu
msg=$(cat "$1")
staged=$(git diff --cached --name-only)
fail() { echo "parity guard: $*" >&2; exit 1; }

harness='^(internal/app/parity_test\.go|internal/app/parity_driver_test\.go|parity/hooks/|parity/oracle\.sh)'
if echo "$staged" | grep -Eq "$harness"; then
	id=$(echo "$msg" | sed -n 's/^Oracle-approved: *\(O-[0-9-]*\).*/\1/p' | head -1)
	[ -n "$id" ] || fail "this commit changes the harness; it needs an 'Oracle-approved: O-…' line (see parity/ORACLE.md)"
	git show :parity/ORACLE.md 2>/dev/null | grep -q "^## $id:" || fail "$id is not in parity/ORACLE.md"
fi

if git diff --cached -U0 -- parity/passing.txt | grep -E '^-[^-#]' >/dev/null; then
	fail "parity/passing.txt may only grow; a test that passed must keep passing"
fi

if git diff --cached -U0 -- go.mod | grep -E '^[-+].*jesseduffield/lazygit' >/dev/null; then
	fail "go.mod: lazygit's version and source are fixed for the parity work"
fi
